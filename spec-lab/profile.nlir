-- profile.nlir — a rule's evaluation profile as prose, and back again.
-- $render%{applicability=[…], decision_boundary=['Decision boundary:\n…', 'MET:\n…', …]}
-- writes the profile Markdown; $fields%$md parses it back into the same dict.
-- Exact inverses on the reference layout; no model calls.
quote={$sub%($trim%$0, '(?m)^', '> ')};
render={"#### `applicability`\n\n" ++ $join%($quote↦$0.applicability, "\n\n") ++ "\n\n#### `decision_boundary`\n\n" ++ $join%($quote↦$0.decision_boundary, "\n\n")};
sub4={$trim%($match%($0, '#### ' ++ $1 ++ '\n([\s\S]*?)(?:\n#### |$)'))};
unquote={$trim%($sub%($0, '(?m)^> ?', ''))};
-- quote and unquote are inverses: declaring it lets `nlir put` push prose edits
-- back through $render to the exact spec field (and template edits to the program).
_inverses={quote=unquote};
fields={{applicability=[$unquote%($sub4%($0, '`applicability`'))], decision_boundary=$unquote↦($filter%({$trim%$0}, $sub4%($0, '`decision_boundary`')//"\n\n"))}}
